source "https://rubygems.org"

# Core site generator
gem "jekyll", "~> 4.3"
# Required for `jekyll serve` on Ruby 3.x and compatibility with GitHub Pages-style setups
# even when only `jekyll build` is used.
gem "webrick", "~> 1.8"

# Plugins
group :jekyll_plugins do
  gem "jekyll-seo-tag", "~> 2.8"
  gem "jekyll-sitemap", "~> 1.4"
end
